{
  "name": "agent-blindspot",
  "version": "0.1.0",
  "description": "Local-first evidence analyzer that finds potentially impacted code your coding agent did not inspect or directly verify.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aprashnasuraj-dev/agent-blindspot.git"
  },
  "bugs": {
    "url": "https://github.com/aprashnasuraj-dev/agent-blindspot/issues"
  },
  "homepage": "https://github.com/aprashnasuraj-dev/agent-blindspot#readme",
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agent",
    "coding-agents",
    "agentic-coding",
    "claude-code",
    "codex",
    "opencode",
    "code-review",
    "developer-tools",
    "static-analysis",
    "impact-analysis",
    "dependency-graph",
    "code-coverage",
    "agent-observability",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-blindspot": "dist/apps/cli/src/index.js"
  },
  "files": [
    "dist/apps/",
    "dist/packages/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/COMPATIBILITY.md",
    "docs/KNOWN_LIMITATIONS.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "benchmark": "npm run build && node benchmarks/benchmark.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run demo",
    "prepack": "npm run clean && npm run build",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "browser:smoke": "npm run build && node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2"
  }
}
